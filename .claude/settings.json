{
  "statusLine": {
    "type": "command",
    "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/scripts/run_python.sh\" \"${CLAUDE_PROJECT_DIR:-.}/scripts/suite_progress.py\" statusline",
    "refreshInterval": 1
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*pytest*)",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/scripts/run_python.sh\" \"${CLAUDE_PROJECT_DIR:-.}/scripts/pytest_reminder_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
